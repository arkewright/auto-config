# 复制为 .env 后编辑。入口用 Bash 读取；ROOT 是仓库绝对路径。数组中每个元素是一个参数。

# 依赖存放的父目录；下面三份源码和 LLVM 安装位置均可单独修改。
DEPS="$ROOT/.deps"
# Linux 源码目录；可指向已经解包或修改过的板厂源码。
LINUX_SRC="$DEPS/linux"
# 缺少 Linux 源码时使用的 Git 仓库。
LINUX_URL=https://github.com/torvalds/linux.git
# 首次克隆 Linux 用的分支或标签；留空使用远端默认分支。
LINUX_REF=v7.4-rc3
# llvm-project 源码根目录，里面有 llvm/ 和 clang/。
LLVM_SRC="$DEPS/llvm-project"
# 缺少 LLVM 源码时使用的 Git 仓库。
LLVM_URL=https://github.com/llvm/llvm-project.git
# 首次克隆 LLVM 用的分支或标签；留空使用远端默认分支。
LLVM_REF=llvmorg-23.1.4
# FTXUI 源码目录；使用下方已安装的软件包时忽略此项。
FTXUI_SRC="$DEPS/ftxui"
# 缺少 FTXUI 源码时使用的 Git 仓库。
FTXUI_URL=https://github.com/ArthurSonzogni/FTXUI.git
# 首次克隆 FTXUI 用的分支或标签；留空使用远端默认分支。
FTXUI_REF=v6.1.9
# 已安装的 FTXUI 的 CMake 配置目录；留空从 FTXUI_SRC 构建。
FTXUI_DIR=''

# LLVM 安装前缀，包含 bin/、include/ 和 lib/；也可以直接选用已有工具链。
LLVM_PREFIX="$DEPS/llvm"
# auto 复用已有工具链、缺少时编译；source 总是从源码编译；installed 只用现有安装。
LLVM_MODE=auto
# 从源码编译 LLVM 的中间文件目录。
LLVM_BUILD="$DEPS/llvm-build"
# 主机上的 Clang 插件和配置处理器的构建目录。
HOST_BUILD="$ROOT/build/host"
# LLVM、宿主工具和内核编译共用的并行任务数。
JOBS=8
# 编译 LLVM、插件和处理器时使用的 CMake 生成器。
CMAKE_GENERATOR=Ninja
# 引导编译 LLVM 的宿主 C 编译器。
BOOTSTRAP_CC=cc
# 引导编译 LLVM 的宿主 C++ 编译器。
BOOTSTRAP_CXX=c++
# 编译项目宿主工具的 C 编译器。
TOOLS_CC="$LLVM_PREFIX/bin/clang"
# 编译插件和处理器的 C++ 编译器，须支持 C++26。
TOOLS_CXX="$LLVM_PREFIX/bin/clang++"
# 宿主工具使用的完整系统根（含 glibc）；留空使用宿主系统。
SYSROOT=''
# 传给 LLVM 的 CMake 参数：选择项目、后端、共享库及链接并行数。
LLVM_CMAKE_ARGS=(-DCMAKE_BUILD_TYPE=Release '-DLLVM_ENABLE_PROJECTS=clang;lld' '-DLLVM_TARGETS_TO_BUILD=X86;RISCV;BPF' -DLLVM_BUILD_LLVM_DYLIB=ON -DLLVM_LINK_LLVM_DYLIB=ON -DCLANG_LINK_CLANG_DYLIB=ON -DLLVM_PARALLEL_LINK_JOBS=1)
# 传给插件和处理器的 CMake 参数。
TOOLS_CMAKE_ARGS=(-DCMAKE_BUILD_TYPE=Release)

# 本次实验的输出根目录，保存配置、内核对象、采集元数据和方案；新实验使用新目录。
WORK="$ROOT/build/board"
# 默认构建 x86_64；交叉编译 riscv64 时改为 riscv，并使用启用 64 位的内核配置。
ARCH=x86_64
# 编译目标内核及树外驱动的 Clang，须能加载本次编译的插件。
KERNEL_CC="$LLVM_PREFIX/bin/clang"
# Kbuild 在主机上运行的辅助程序使用的 C 编译器。
HOSTCC="$LLVM_PREFIX/bin/clang"
# Kbuild 在主机上运行的辅助程序使用的 C++ 编译器。
HOSTCXX="$LLVM_PREFIX/bin/clang++"
# 传给每次 Kbuild 调用的附加参数，例如 ('KCFLAGS=-O2 -g0' CROSS_COMPILE=riscv64-linux-gnu-)。
KBUILD_ARGS=()
# 完整的起始 .config；留空运行原生 allyesconfig 并设置采集所需开关，指定文件则从副本运行 olddefconfig。
KERNEL_CONFIG=''
# 基线和采集版在 olddefconfig 前交给 Linux scripts/config 的可选参数，例如 (--disable WERROR)。
CONFIG_OPTIONS=()
# 留空自动选镜像和 modules；架构有 boot/dts 时还编译 dtbs。自定义时首项放镜像，如 (bzImage modules)。
KERNEL_TARGETS=()
# 对象目录内要打包的镜像路径；留空取架构启动目录中的第一个目标，x86_64 为 arch/x86/boot/bzImage。
KERNEL_IMAGE=''
# 追加到内核版本的本地后缀；入口再追加角色名，采集版还带本次采集标识的短前缀。
RELEASE_SUFFIX=-kcfg

# 板级五列观测清单；留空根据下方策略从 Kbuild 的直接绑定生成。
SCOPE=''
# 允许在启动和负载均未命中时关闭的 Kconfig 名称，例如 (CONFIG_NLS_CODEPAGE_850)。
DROP=()
# 允许在系统就绪后作为模块加载的 Kconfig 名称，例如 (CONFIG_IKCONFIG)。
DEFER=()
# 板端采集后传回主机的主快照。
TRACE="$WORK/trace.tsv"
# 同一次采集构建的其他负载快照路径；处理时合并各阶段的命中。
EXTRA_TRACES=()

# 部署包的输出目录。
PACKAGE_DIR="$WORK/packages"
# 包名前缀，例如 kernel 生成 kernel-profile.tar.gz；包内顶层目录同名去掉 .tar.gz。
PACKAGE_NAME=kernel
# 交给 gzip 的压缩级别，1 最快，9 压缩率最高。
GZIP_LEVEL=6
# 传给 Kbuild 的 INSTALL_MOD_STRIP；1 移除模块调试信息，留空保留。
MODULE_STRIP=1
# 原样放入部署包的独立板端脚本；可编辑默认文件或指定自己的一份。
DEPLOY_SCRIPT="$ROOT/deploy.sh"
# 运行主机采集元数据工具的 Python 3.11 或更新版本。
PYTHON=python3
