# 在主机仓库根目录复制为 board.env，填写后执行 source ./board.env。
export BOARD=ubuntu@board
export BOARD_DIR=board-01
export WORK="$PWD/build/$BOARD_DIR"
# 填板上当前 GRUB 默认项实际读取的两个文件的 Linux 绝对路径，三版固定。
export GRUB_KERNEL=
export GRUB_INITRD=

# 缺省下载到 .deps；取消相应注释即可改用本机的依赖。
# export DEPS=/data/kernel-deps
# export LINUX=/src/vendor-linux
# export LLVM_SOURCE=/src/llvm-project
# export SDK=/opt/llvm
# export FTXUI_SOURCE_DIR=/src/FTXUI
# export FTXUI_DIR=/opt/ftxui/lib/cmake/ftxui
# export JOBS=8

# 原生 allyesconfig 之后，按板子实际需要应用的 Kconfig 片段。
# export BOARD_CONFIG="$PWD/board.config"
# 只填这块板允许关闭或延迟加载的选项，以空格分隔。以下是写法示例。
# export DROP='CONFIG_NLS_CODEPAGE_850'
# export DEFER='CONFIG_IKCONFIG'
# export SCOPE=/data/audited-scope.tsv

# 默认 Image。仅在默认启动项需要外置设备树、其他镜像格式或签名时填写。
# export DTB=starfive/jh7110-starfive-visionfive-2-v1.3b.dtb
# export GRUB_DTB=/boot/board.dtb
# export IMAGE_TARGET=vmlinuz.efi
# export EFI_KEY=/keys/db.key EFI_CERT=/keys/db.crt
