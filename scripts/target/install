#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
umask 022

die() { printf '%s\n' "$*" >&2; exit 1; }
[[ $# == 0 ]] || die 'usage: sudo ./install'
((EUID == 0)) || die 'run the packaged installer as root on the board'

bundle=$(dirname -- "${BASH_SOURCE[0]}")
IFS= read -r release < "$bundle/release"
[[ $release =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] || die 'invalid kernel release'
IFS= read -r grub_kernel < "$bundle/GRUB_KERNEL"
IFS= read -r grub_initrd < "$bundle/GRUB_INITRD"
IFS= read -r grub_dtb < "$bundle/GRUB_DTB"
IFS= read -r dtb < "$bundle/DTB"

# Resolve only the parent; mv replaces a destination symlink, not its referent.
boot_file() {
    local name=$1 path=$2 parent
    [[ $path == /* && $path != */ && ${path##*/} != . && ${path##*/} != .. ]] ||
        die "$name must be an absolute Linux file path"
    parent=$(realpath -e -- "${path%/*}/") || die "missing parent directory for $name: $path"
    path="${parent%/}/${path##*/}"
    [[ ! -e $path || -f $path || -L $path ]] || die "$name is not a file: $path"
    printf '%s\n' "$path"
}

kernel=$(boot_file GRUB_KERNEL "$grub_kernel")
initrd=$(boot_file GRUB_INITRD "$grub_initrd")
boot_root=$(realpath -e -- /boot)
config="$boot_root/config-$release"
[[ $kernel != "$initrd" && $kernel != "$config" && $initrd != "$config" ]] || die 'boot paths must be distinct'
if [[ -n $grub_dtb || -n $dtb ]]; then
    board_dtb=$(boot_file GRUB_DTB "$grub_dtb")
    [[ $board_dtb != "$kernel" && $board_dtb != "$initrd" && $board_dtb != "$config" ]] || die 'boot paths must be distinct'
    [[ -n $dtb && /$dtb/ != *//* && /$dtb/ != */./* && /$dtb/ != */../* ]] ||
        die 'DTB must name a file relative to the packaged device tree'
fi

# Stage each fixed-path file on its destination filesystem before replacing any.
slots=()
cleanup() { if ((${#slots[@]})); then rm -rf -- "${slots[@]}"; fi; }
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
kernel_slot=$(mktemp -d -- "${kernel%/*}/.kcfg-install.XXXXXXXX"); slots+=("$kernel_slot")
initrd_slot=$(mktemp -d -- "${initrd%/*}/.kcfg-install.XXXXXXXX"); slots+=("$initrd_slot")
install -m 0644 -- "$bundle/boot/Image" "$kernel_slot/Image"
if [[ -n $grub_dtb ]]; then
    dtb_slot=$(mktemp -d -- "${board_dtb%/*}/.kcfg-install.XXXXXXXX"); slots+=("$dtb_slot")
    install -m 0644 -- "$bundle/dtbs/$dtb" "$dtb_slot/board.dtb"
fi

modules_root=$(realpath -e -- /lib/modules)
trees_root=$(realpath -m -- "$boot_root/dtbs")
modules="$modules_root/$release"
trees="$trees_root/$release"
[[ ! -L $modules && ! -L $trees ]] || die 'versioned module or device tree directory is a symlink'
mkdir -p -- "$modules" "$trees"
rsync -a --no-owner --no-group --delete -- "$bundle/lib/modules/$release/" "$modules/"
install -m 0644 -T -- "$bundle/boot/config" "$config"
depmod -a "$release"
mkinitramfs -o "$initrd_slot/initrd" "$release"
rsync -a --no-owner --no-group --delete -- "$bundle/dtbs/" "$trees/"

if [[ -n $grub_dtb ]]; then mv -fT -- "$dtb_slot/board.dtb" "$board_dtb"; fi
mv -fT -- "$initrd_slot/initrd" "$initrd"
mv -fT -- "$kernel_slot/Image" "$kernel"
